# Build artifacts
/netglance
backend/netglance
frontend/dist/
frontend/node_modules/
frontend/tsconfig.tsbuildinfo
# dist/ is build output, except the installer itself: it's committed so a
# clone always carries a ready-to-run build. dist/deps/ (the cached arp-scan
# package) stays out — build.sh refetches it.
/dist/*
!/dist/installer.sh
# The frontend build lands here. Only .gitkeep is tracked: `//go:embed all:dist`
# needs the directory to be non-empty to compile on a fresh clone, and an empty
# file is the one thing a build never rewrites — so building doesn't leave a
# modified file behind every time.
backend/internal/webui/dist/*
!backend/internal/webui/dist/.gitkeep

# Dev data
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env
.env
.env.local

# Claude Code session artifacts
.claude/
