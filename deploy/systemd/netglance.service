[Unit]
Description=netglance — LAN host discovery and inventory
Documentation=https://github.com/netglance/netglance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/netglance
Restart=on-failure
RestartSec=5

# Run unprivileged; arp-scan needs CAP_NET_RAW + CAP_NET_ADMIN, granted via
# AmbientCapabilities so the binary inherits them when it execs arp-scan.
User=netglance
Group=netglance
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

# State lives in /var/lib/netglance (owned by the netglance user). systemd
# creates it on first start.
StateDirectory=netglance
Environment=NETGLANCE_DATA_DIR=/var/lib/netglance
# Default listen on all interfaces, port 8473. Override in a drop-in:
#   systemctl edit netglance
#   [Service]
#   Environment=NETGLANCE_BIND=127.0.0.1:8473
Environment=NETGLANCE_BIND=:8473

# Hardening — netglance only needs to read the OUI data it bundles, write
# its DB under StateDirectory, and exec arp-scan. Everything else is locked.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
