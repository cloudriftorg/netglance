#!/bin/sh
#
# PROVIDE: netglance
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# rc(8) variables:
# netglance_enable    YES|NO     enable the daemon. Default NO.
# netglance_user      string     UID. Default "root" (arp-scan needs BPF).
# netglance_env_file  path       env file sourced before launch. Default
#                                "/usr/local/etc/netglance/netglance.env" —
#                                regenerated by the os-netglance plugin on
#                                every Save in Services > Netglance.

. /etc/rc.subr

name=netglance
rcvar=netglance_enable

load_rc_config $name

: ${netglance_enable:=NO}
# Default to root because arp-scan(1) on FreeBSD needs /dev/bpf*, which is
# only readable by root unless devfs rules grant a non-privileged user
# access. Override netglance_user in /etc/rc.conf if you want to lock
# this down.
: ${netglance_user:=root}
: ${netglance_env_file:=/usr/local/etc/netglance/netglance.env}

# Source the env file in the rc-script's own shell so daemon(8) inherits
# the NETGLANCE_* variables. The previous /bin/sh -c '...' wrapper was
# fragile under quoting (rc.subr's eval mangled the inner single quotes).
if [ -r "${netglance_env_file}" ]; then
    . "${netglance_env_file}"
fi

pidfile=/var/run/${name}.pid
logfile=/var/log/${name}.log
procname=/usr/local/sbin/${name}
command=/usr/sbin/daemon
command_args="-f -p ${pidfile} -o ${logfile} -t ${name} -u ${netglance_user} ${procname}"

required_files="${procname}"

run_rc_command "$1"
