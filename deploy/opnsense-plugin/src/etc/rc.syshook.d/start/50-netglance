#!/bin/sh

# Boot hook: start netglance only if the OPNsense plugin is enabled.
# Mirrors the pattern used by official plugins (ntopng, wireguard, …):
# guard on the model's `enabled` flag, then issue a `restart` (idempotent)
# via configd.
#
# `-d` (no value) tells configctl to wait for configd to come up — on
# slow boots this matters. Earlier versions of this script passed
# `-d 30`, which configctl actually parses as `-d` + the literal command
# `30 template reload OPNsense/Netglance` — that returned "Action not
# allowed or missing" and the daemon never started.

[ "$(/usr/local/sbin/pluginctl -g OPNsense.netglance.general.enabled)" = "1" ] || exit 0

# Render the env template from the model first so the daemon picks up
# the current scanIfaces / httpPort, then restart so we land in a known
# state regardless of whether the daemon is already running.
/usr/local/sbin/configctl -d template reload OPNsense/Netglance
/usr/local/sbin/configctl -d netglance restart
