<model>
    <mount>//OPNsense/netglance/general</mount>
    <description>netglance configuration</description>
    <version>0.0.1</version>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <bindAddress type="TextField">
            <Default>0.0.0.0</Default>
            <Required>Y</Required>
            <ValidationMessage>Bind address must be an IPv4 or IPv6 address (use 0.0.0.0 for all)</ValidationMessage>
            <Mask>/^([0-9]{1,3}\.){3}[0-9]{1,3}$|^\[?[0-9a-fA-F:]+\]?$/u</Mask>
        </bindAddress>
        <httpPort type="PortField">
            <Default>8473</Default>
            <Required>Y</Required>
        </httpPort>
        <scanIfaces type="InterfaceField">
            <Required>N</Required>
            <Multiple>Y</Multiple>
            <AllowDynamic>Y</AllowDynamic>
        </scanIfaces>
        <scanInterval type="IntegerField">
            <Default>120</Default>
            <Required>Y</Required>
            <MinimumValue>30</MinimumValue>
            <MaximumValue>86400</MaximumValue>
            <ValidationMessage>Interval must be between 30 and 86400 seconds</ValidationMessage>
        </scanInterval>
        <networks type="TextField">
            <Required>N</Required>
            <Mask>/^(\s*([0-9]{1,3}\.){3}[0-9]{1,3}\/[0-9]{1,2}(:[0-9]{0,4})?(:[a-zA-Z0-9_\- ]{0,32})?\s*\r?\n?)*$/u</Mask>
            <ValidationMessage>One entry per line: cidr[:vlan[:name]] (e.g. 192.168.1.0/24:0:LAN)</ValidationMessage>
        </networks>
    </items>
</model>
