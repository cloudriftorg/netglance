# Auto-generated by the os-netglance OPNsense plugin from the General model.
# Do NOT edit by hand: changes here are overwritten on every Save in the
# Services > Netglance panel. Edit the OPNsense config instead.

{% set cfg = OPNsense.netglance.general %}
{% set sifaces = cfg.scanIfaces or '' %}
{% set ifaces = [] %}
{% for ifname in sifaces.split(',') %}{% set n = ifname.strip() %}{% if n %}{% if interfaces is defined and n in interfaces and interfaces[n]['if'] %}{% set _ = ifaces.append(interfaces[n]['if']) %}{% else %}{% set _ = ifaces.append(n) %}{% endif %}{% endif %}{% endfor %}
{# Interface → 802.1Q tag, straight from the firewall's own VLAN config, so a
   host is labelled with the VLAN it actually answered on instead of one
   guessed from its IP. `vlanif` is the device name (vlan02, igc1_vlan20, …),
   `tag` the VLAN id. A single VLAN comes through as a dict, several as a list;
   normalise before iterating. #}
{% set vlanmap = [] %}
{% if vlans is defined and vlans.vlan is defined %}{% set vlanlist = [vlans.vlan] if vlans.vlan is mapping else vlans.vlan %}{% for v in vlanlist %}{% if v.vlanif is defined and v.tag is defined %}{% set _ = vlanmap.append(v.vlanif ~ '=' ~ v.tag) %}{% endif %}{% endfor %}{% endif %}
export NETGLANCE_MANAGED=1
export NETGLANCE_DATA_DIR=/var/db/netglance
export NETGLANCE_HTTP_PORT={{ cfg.httpPort or '8473' }}
export NETGLANCE_SCAN_IFACES={{ ifaces|join(',') }}
export NETGLANCE_IFACE_VLANS={{ vlanmap|join(',') }}
