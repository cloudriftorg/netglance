# Auto-generated by the os-netglance OPNsense plugin from the General model.
# Do NOT edit by hand: changes here are overwritten on every Save in the
# Services > Netglance panel. Edit the OPNsense config instead.

{% set cfg = OPNsense.netglance.general %}
export NETGLANCE_MANAGED=1
export NETGLANCE_DATA_DIR=/var/db/netglance

export NETGLANCE_BIND_ADDRESS={{ cfg.bindAddress|default('0.0.0.0') }}
export NETGLANCE_HTTP_PORT={{ cfg.httpPort|default('8473') }}
export NETGLANCE_SCAN_INTERVAL={{ cfg.scanInterval|default('120') }}
export NETGLANCE_SCAN_ENABLED={{ cfg.enabled|default('0') }}

{% set ifaces = '' %}
{% if cfg.scanIfaces is defined and cfg.scanIfaces is not empty %}
    {% for ifname in cfg.scanIfaces|split(',') %}
        {%- set realname = '' -%}
        {%- if interfaces is defined and interfaces[ifname] is defined and interfaces[ifname]['if'] is defined -%}
            {%- set realname = interfaces[ifname]['if'] -%}
        {%- else -%}
            {%- set realname = ifname -%}
        {%- endif -%}
        {%- if realname != '' -%}
            {%- if ifaces != '' -%}{%- set ifaces = ifaces ~ ',' -%}{%- endif -%}
            {%- set ifaces = ifaces ~ realname -%}
        {%- endif -%}
    {% endfor %}
{% endif %}
export NETGLANCE_SCAN_IFACES={{ ifaces }}

{% set nets = '' %}
{% if cfg.networks is defined and cfg.networks is not empty %}
    {% for line in cfg.networks|split('\n') %}
        {%- set line = line|trim -%}
        {%- if line != '' -%}
            {%- if nets != '' -%}{%- set nets = nets ~ ',' -%}{%- endif -%}
            {%- set nets = nets ~ line -%}
        {%- endif -%}
    {% endfor %}
{% endif %}
export NETGLANCE_NETWORKS={{ nets }}
